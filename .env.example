# Copy to .env and fill in. .env is gitignored - never commit real keys.

# LLM: any OpenAI-compatible endpoint. Default = Google Gemini free tier.
# Key: https://aistudio.google.com -> Get API key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Tracing: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-review

# Optional: default repo when --repo isn't passed (owner/repo)
# GITHUB_REPOSITORY=
